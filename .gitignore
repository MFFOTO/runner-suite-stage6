# Model weights -- never tracked. YOLO .pt files auto-download by name on first
# run; .onnx are exported locally when a DirectML/onnx backend is used. Keeping
# them out of git avoids pull conflicts with each machine's local copy and keeps
# the repo small.
*.pb
*.pth
*.part
*.pt
*.onnx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS
.DS_Store

# Tooling
.claude/

# Per-machine config (each machine keeps its own paths). Copy the matching
# *.example.json -> the real file and edit. Keeps git pull conflict-free.
settings.json
settings_enhancer.json
runner_crop_report.csv
